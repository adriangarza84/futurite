---
interface Props {
  /* Cuatro datos en línea, sin título de sección. Sin animación de conteo:
     el brief lo pide explícitamente y además obligaría a meter JavaScript en
     una página que no tiene ninguno. */
  datos: { valor: string; etiqueta: string }[];
}
const { datos } = Astro.props;
---

<section class="seccion franja">
  <ul class="contenedor franja__lista">
    {datos.map((d) => (
      <li class="franja__item">
        <span class="franja__valor">{d.valor}</span>
        <span class="franja__etiqueta">{d.etiqueta}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  /* Banda compacta: va pegada al hero y su trabajo es dar respaldo, no ocupar
     una pantalla entera. Por eso rompe el padding de .seccion. */
  .franja {
    background: var(--color-acento-pastel);
    border-bottom: 2px solid var(--color-borde);
    padding: 40px 0;
  }
  /* Ojo con el margen: este <ul> es a la vez el .contenedor de la página, así
     que el margen horizontal tiene que seguir siendo auto o la franja entera
     se va contra el borde izquierdo en vez de centrarse. */
  .franja__lista {
    list-style: none;
    margin: 0 auto;
    padding-top: 0;
    padding-bottom: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }
  /* Los cuatro datos van centrados. El filete separa, así que va entre
     columnas y no antes de la primera. El padding es igual en los cuatro para
     que los centros queden a la misma distancia entre sí. */
  .franja__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 0 14px;
    text-align: center;
  }
  .franja__item + .franja__item {
    border-left: 3px solid var(--color-acento);
  }
  .franja__valor {
    font-size: 30px;
    font-weight: 900;
    line-height: 1.1;
    color: var(--color-marca);
  }
  .franja__etiqueta {
    font-size: 15.5px;
    line-height: 1.45;
    color: var(--color-texto-suave);
    /* Tope de medida: sin él, la etiqueta más corta se estira todo el ancho de
       su columna y el bloque pierde el eje central. */
    max-width: 28ch;
  }

  @media (max-width: 991px) {
    /* Dos columnas, no cuatro: a cuatro las etiquetas se parten en cinco
       renglones y el dato deja de leerse de un golpe. */
    .franja__lista { grid-template-columns: repeat(2, 1fr); gap: 26px 24px; }
    .franja__valor { font-size: 26px; }
    /* En dos columnas el filete solo separa las parejas: en el tercer dato
       sería una línea al principio de un renglón. */
    .franja__item + .franja__item { border-left: 0; }
    .franja__item:nth-child(even) { border-left: 3px solid var(--color-acento); }
  }
  @media (max-width: 480px) {
    .franja__valor { font-size: 22px; }
    .franja__etiqueta { font-size: 14.5px; }
  }
</style>
