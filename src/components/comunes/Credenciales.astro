---
interface Props {
  /* Qué sello manda en la jerarquía visual. En redes sociales pesa más el de
     Meta y los dos van al mismo tamaño; en Google Ads el de Google va primero
     y más grande, porque es la credencial que respalda el servicio de la
     página. El orden del DOM no cambia: se resuelve con el tamaño. */
  destacado?: 'ninguno' | 'google';
  /* Cada párrafo admite <strong>: es el único markup que lleva el bloque y se
     inyecta con set:html para que el estilo del componente siga alcanzándolo
     (un <slot> traería el ámbito de la página, no el de aquí). */
  parrafos: string[];
}
const { destacado = 'ninguno', parrafos } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class:list={['seccion', 'credenciales', destacado === 'google' && 'credenciales--google']}>
  <div class="contenedor credenciales__inner">
    <div class="credenciales__badges">
      {/* Los logotipos oficiales de los dos programas. El de Google es un
          sello cuadrado y el de Meta un lockup horizontal: cada uno tiene su
          propia caja para que ninguno se vea deformado ni desproporcionado.
          Los dos van al ras del mismo borde izquierdo. Para eso hubo que
          recortar el viewBox del SVG de Meta, que traía ~400 unidades de aire
          por lado y metía el logo 5% hacia adentro de su caja. */}
      <img
        class="badge badge--google"
        src={`${base}/assets/img/credenciales/google-partner-premier-2026.webp`}
        alt="Google Partner Premier 2026"
        width="440"
        height="420"
        loading="lazy"
        decoding="async"
      />
      <img
        class="badge badge--meta"
        src={`${base}/assets/img/credenciales/meta-business-partner.svg`}
        alt="Meta Business Partners"
        width="6550"
        height="404"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="credenciales__texto">
      {parrafos.map((texto) => <p set:html={texto} />)}
    </div>
  </div>
</section>

<style>
  .credenciales { background: var(--color-fondo-alt); }
  .credenciales__inner {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 44px;
    align-items: center;
  }
  .credenciales__badges {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }
  .badge { display: block; width: auto; height: auto; margin-left: 0; }
  .badge--google { height: 150px; width: auto; max-width: 100%; }
  .badge--meta { width: 280px; height: auto; max-width: 100%; }
  .credenciales__texto p { font-size: 18px; color: var(--color-texto-suave); }
  .credenciales__texto :global(strong) { color: var(--color-marca); }
  .credenciales__texto p:last-child { margin-bottom: 0; }

  /* En la página de Google Ads el sello de Google crece y el de Meta baja a
     acompañante. Es la única diferencia entre las dos versiones del bloque. */
  .credenciales--google .badge--google { height: 200px; }
  .credenciales--google .badge--meta { width: 220px; opacity: .92; }

  @media (max-width: 991px) {
    .credenciales__inner { grid-template-columns: 1fr; gap: 28px; }
    /* En una sola columna los dos sellos caben lado a lado. */
    .credenciales__badges { flex-direction: row; align-items: center; gap: 30px; }
    .badge--google { height: 116px; }
    .badge--meta { width: 250px; }
    .credenciales--google .badge--google { height: 150px; }
    .credenciales--google .badge--meta { width: 200px; }
  }
  @media (max-width: 575px) {
    /* Apilados otra vez: el lockup de Meta es muy alargado y al lado del sello
       cuadrado se queda sin ancho para leerse. */
    .credenciales__badges { flex-direction: column; align-items: flex-start; gap: 22px; }
    .badge--google { height: 120px; }
    .badge--meta { width: 240px; }
    .credenciales--google .badge--google { height: 150px; }
    .credenciales--google .badge--meta { width: 210px; }
  }
</style>
