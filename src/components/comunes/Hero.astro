---
interface Props {
  antetitulo: string;
  titulo: string;
  bajada: string;
  botones: { texto: string; href: string; variante: 'primario' | 'fantasma'; gtm?: string }[];
  /* Nombre del archivo, sin ruta: cada página de servicio trae su propio clip.
     El póster es el primer cuadro de ese mismo video, así que van en pareja. */
  video: string;
  poster: string;
}

const { antetitulo, titulo, bajada, botones, video: archivoVideo, poster: archivoPoster } = Astro.props;

// Mismos archivos que hoy sirve el sitio, en las mismas rutas. El póster es el
// primer cuadro del propio video: no hay salto cuando el video arranca y solo
// se descarga una imagen, no dos.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const poster = `${base}/assets/img/heroes/${archivoPoster}`;
const video = `${base}/assets/video/${archivoVideo}`;
---

<section class="hero hv-hero" style={`--poster: url('${poster}')`}>
  {/* El video es un adorno: si no carga, si el navegador no lo deja reproducir
      o si el usuario pidió menos movimiento, queda el póster y la página se ve
      igual. Por eso el src va en data-src y lo activa hero-video.js. */}
  <video
    class="hv-video"
    data-src={video}
    autoplay
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
    tabindex="-1"></video>

  <div class="contenedor hero__inner">
    {/* Antetítulo con peso visual de H2 pero marcado como <p>: la página
        conserva un solo H1 y el orden de encabezados no se rompe. */}
    <p class="hero__antetitulo">{antetitulo}</p>
    <h1 class="hero__h1">{titulo}</h1>
    <p class="hero__bajada">{bajada}</p>
    <div class="hero__botones">
      {botones.map((b) => (
        <a
          class={`btn btn--${b.variante}`}
          href={b.href}
          data-gtm-evento="cta_click"
          data-gtm-posicion={b.gtm}
        >
          {b.texto}
        </a>
      ))}
    </div>
  </div>
</section>

{/* Único script de la página además de GTM, y no renderiza nada: solo decide
    si vale la pena descargar el video. Mismo criterio que hero-video.js del
    sitio. Si este script no corre, el hero se queda en el póster. */}
<script is:inline>
  (function () {
    var v = document.querySelector('.hv-video');
    if (!v || !v.dataset.src) return;
    // Ni en móvil ni en tablet: ahí el costo de datos no se justifica y es
    // donde el rendimiento está más apretado.
    if (!window.matchMedia('(min-width: 992px)').matches) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    v.addEventListener('canplay', function () { v.classList.add('hv-lista'); }, { once: true });
    v.src = v.dataset.src;
    var p = v.play();
    if (p && p.catch) p.catch(function () { /* autoplay bloqueado: queda el póster */ });
  })();
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--grad-oscuro);
    background-image: var(--poster), var(--grad-oscuro);
    background-size: cover;
    background-position: center;
    color: #fff;
    padding: 92px 0 84px;
  }

  .hv-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    /* Arranca invisible y aparece cuando ya hay imagen: evita el parpadeo
       negro del primer cuadro sobre el póster. */
    opacity: 0;
    transition: opacity .6s ease-in;
    pointer-events: none;
  }
  .hv-video.hv-lista { opacity: 1; }

  /* Capa oscura: el clip es más claro que el fondo de marca y el texto del
     hero es blanco. Mismo degradado que usa el sitio hoy. */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(90deg, rgba(0, 28, 46, .86) 0%, rgba(0, 28, 46, .66) 45%, rgba(0, 28, 46, .42) 100%),
      radial-gradient(circle at 18% 22%, rgba(0, 205, 255, .16), transparent 42%);
    pointer-events: none;
  }

  .hero__inner { position: relative; z-index: 2; max-width: 900px; }

  .hero__antetitulo {
    font-size: 22px;
    font-weight: 800;
    color: var(--color-acento);
    margin: 0 0 14px;
    line-height: 1.3;
  }
  .hero__h1 { color: #fff; margin-bottom: 18px; }
  .hero__bajada {
    font-size: 19px;
    color: rgba(255, 255, 255, .9);
    max-width: 66ch;
    margin-bottom: 30px;
  }
  .hero__botones { display: flex; flex-wrap: wrap; gap: 14px; }

  /* Sin video en móvil ni tablet, y sin video para quien pidió menos
     movimiento: en ambos casos se queda el póster. */
  @media (max-width: 991px) {
    .hv-video { display: none; }
    .hero { padding: 66px 0 58px; }
    .hero__antetitulo { font-size: 19px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hv-video { display: none; }
  }
  @media (max-width: 767px) {
    .hero { padding: 42px 0 44px; }
    .hero__antetitulo { font-size: 17px; }
    .hero__bajada { font-size: 16.5px; margin-bottom: 24px; }
    .hero__botones { flex-direction: column; gap: 12px; }
  }
</style>
