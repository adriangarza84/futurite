---
// Ilustraciones de línea para los bloques de argumento, en color de marca.
// Son decorativas (aria-hidden) y pesan ~1 KB cada una: no compiten con el LCP
// ni obligan a esperar los assets definitivos. Si marketing entrega piezas
// finales, se pasa la prop `imagen` a BloqueArgumento y estas dejan de usarse.

interface Props {
  tipo: 'dato' | 'creativo' | 'decisiones';
}
const { tipo } = Astro.props;
---

<div class="figura" aria-hidden="true">
  {tipo === 'dato' && (
    <svg viewBox="0 0 320 240" role="presentation" focusable="false">
      <rect x="18" y="26" width="284" height="188" rx="16" class="tz" />
      <line x1="18" y1="64" x2="302" y2="64" class="tz" />
      <circle cx="40" cy="45" r="5" class="fill-ac" />
      <circle cx="58" cy="45" r="5" class="fill-ac op" />
      <circle cx="76" cy="45" r="5" class="fill-ac op" />
      <rect x="44" y="92" width="86" height="86" rx="12" class="tz" />
      <path d="M62 135l16 16 30-34" class="tz gruesa" />
      <line x1="158" y1="100" x2="272" y2="100" class="tz" />
      <line x1="158" y1="126" x2="248" y2="126" class="tz" />
      <line x1="158" y1="152" x2="272" y2="152" class="tz" />
      <line x1="158" y1="178" x2="214" y2="178" class="tz" />
      <circle cx="268" cy="182" r="22" class="fill-ac" />
      <path d="M258 182l7 7 13-14" class="tz blanca gruesa" />
    </svg>
  )}

  {tipo === 'creativo' && (
    <svg viewBox="0 0 320 240" role="presentation" focusable="false">
      <rect x="16" y="40" width="112" height="160" rx="14" class="tz" />
      <rect x="140" y="26" width="76" height="132" rx="12" class="tz" />
      <rect x="228" y="52" width="76" height="132" rx="12" class="tz" />
      <path d="M44 150l24-30 20 24 16-18 24 30" class="tz" />
      <circle cx="58" cy="82" r="13" class="fill-ac" />
      <line x1="156" y1="62" x2="200" y2="62" class="tz" />
      <line x1="156" y1="82" x2="190" y2="82" class="tz" />
      <line x1="156" y1="102" x2="200" y2="102" class="tz" />
      <line x1="244" y1="88" x2="288" y2="88" class="tz" />
      <line x1="244" y1="108" x2="276" y2="108" class="tz" />
      <path d="M160 190l14-14 14 14-14 14z" class="fill-ac" />
      <path d="M206 206l10-10 10 10-10 10z" class="fill-ac op" />
    </svg>
  )}

  {tipo === 'decisiones' && (
    <svg viewBox="0 0 320 240" role="presentation" focusable="false">
      <rect x="18" y="30" width="284" height="180" rx="16" class="tz" />
      <line x1="52" y1="176" x2="272" y2="176" class="tz" />
      <line x1="52" y1="62" x2="52" y2="176" class="tz" />
      <rect x="72" y="124" width="30" height="52" rx="6" class="fill-ac op" />
      <rect x="120" y="98" width="30" height="78" rx="6" class="fill-ac op" />
      <rect x="168" y="112" width="30" height="64" rx="6" class="fill-ac op" />
      <rect x="216" y="66" width="30" height="110" rx="6" class="fill-ac" />
      <path d="M72 108l48-24 48 12 48-44" class="tz gruesa" />
      <circle cx="216" cy="52" r="9" class="fill-ac" />
    </svg>
  )}
</div>

<style>
  .figura {
    background: var(--color-acento-pastel);
    border: 2px solid var(--color-borde);
    border-radius: var(--radio-card);
    padding: 22px;
  }
  .figura svg { display: block; width: 100%; height: auto; }

  .tz {
    fill: none;
    stroke: var(--color-marca);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .gruesa { stroke-width: 3.4; }
  .blanca { stroke: #fff; }
  .fill-ac { fill: var(--color-acento); stroke: none; }
  .op { opacity: .5; }
</style>
