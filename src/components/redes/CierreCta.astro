---
interface Props {
  titulo: string;
  cta: { texto: string; href: string };
}
const { titulo, cta } = Astro.props;

// Los cuatro enlaces cruzados obligatorios del brief. Van dentro del texto,
// no como lista de botones, y llevan su propio evento de medición.
const cruzados = [
  { texto: 'posicionamiento SEO orgánico', href: 'https://futurite.com/agencia-seo', id: 'seo' },
  { texto: 'campañas en buscadores con Google Ads', href: 'https://futurite.com/google-ads', id: 'google-ads' },
  { texto: 'tiendas en línea', href: 'https://futurite.com/comercio-electronico', id: 'comercio-electronico' },
  { texto: 'campañas para consultorios y clínicas', href: 'https://futurite.com/marketing-medico', id: 'marketing-medico' },
];
---

<section class="seccion cierre">
  <div class="contenedor cierre__inner">
    <h2 class="cierre__titulo">{titulo}</h2>
    <a
      class="btn btn--primario cierre__btn"
      href={cta.href}
      data-gtm-evento="cta_click"
      data-gtm-posicion="cierre"
    >
      {cta.texto}
    </a>

    {/* Todo en una línea a propósito: si el <a> y su signo de puntuación se
        parten en varias líneas, el compilador deja un espacio antes de la coma. */}
    <p class="cierre__cruzados">
      Las redes rinden más acompañadas: {cruzados.map((c, i) => (<><a href={c.href} data-gtm-evento="link_servicio" data-gtm-servicio={c.id}>{c.texto}</a>{i < cruzados.length - 2 ? ', ' : i === cruzados.length - 2 ? ' y ' : '.'}</>))}
    </p>
  </div>
</section>

<style>
  .cierre {
    background: var(--grad-medio);
    color: #fff;
    text-align: center;
  }
  .cierre__inner { max-width: 820px; }
  .cierre__titulo {
    color: #fff;
    font-size: 32px;
    margin-bottom: 28px;
  }
  .cierre__btn { margin-bottom: 30px; }
  .cierre__cruzados {
    margin: 0;
    color: rgba(255, 255, 255, .88);
    font-size: 17px;
  }
  .cierre__cruzados a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cierre__cruzados a:hover { color: var(--color-acento); }

  @media (max-width: 767px) {
    .cierre__titulo { font-size: 24px; }
    .cierre__cruzados { font-size: 16px; }
  }
</style>
